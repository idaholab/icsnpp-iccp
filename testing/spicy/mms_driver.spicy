public type DeleteNamedListEvidenceCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        print "scope=%d names=%d retained=%d" % (
            self.pdu.deleteScope,
            self.pdu.nameCount,
            |self.pdu.namedListMemberNames|
        );

        local index: uint64 = 0;
        while (index < |self.pdu.namedListMemberNames|) {
            print "name[%d]=%d/%s/%s" % (
                index,
                self.pdu.namedListMemberScopes[index],
                self.pdu.namedListMemberDomains[index],
                self.pdu.namedListMemberNames[index]
            );
            index += 1;
        }
    }
};

