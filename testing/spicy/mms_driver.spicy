        print "type=%s decoded=%s local=%d maxCalling=%d maxCalled=%d nesting=%d version=%d parameterUnused=%d parameter=%s servicesUnused=%d services=%s" % (
            self.pdu.pduType,
            self.pdu.semanticDecoded,
            self.pdu.localDetail,
            self.pdu.maxCalling,
            self.pdu.maxCalled,
            self.pdu.nestingLevel,
            self.pdu.version,
            self.pdu.parameterCbbUnusedBits,
            self.pdu.parameterCbb,
            self.pdu.servicesUnusedBits,
            self.pdu.services
        );
    }
};

