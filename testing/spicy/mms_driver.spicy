public type GetNameListEvidenceCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        print "count=%d more=%s" % (
            self.pdu.identifierCount,
            self.pdu.moreFollows
        );

        local index: uint64 = 0;
        while (index < |self.pdu.getNameListIdentifiers|) {
            print "identifier[%d]=%s" % (
                index,
                self.pdu.getNameListIdentifiers[index]
            );
            index += 1;
        }
    }
};

