            self.pdu.eventTransitionTimeChoice,
            self.pdu.eventTransitionTimeSequenceIdentifier,
            self.pdu.eventTransitionTimeRaw,
            self.pdu.eventNotificationLost,
            self.pdu.eventAlarmAcknowledgmentRulePresent,
            self.pdu.eventAlarmAcknowledgmentRule,
