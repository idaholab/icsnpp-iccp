public type InformationReportResultsCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        print "type=%s access=%d variables=%d/%d/%d results=%d/%d/%d/%d/%d first=%s/%s/%s choices=%d/%d/%d errors=%d/%d/%d integers=%d/%d/%d strings=%s/%s/%s" % (
            self.pdu.pduType,
            self.pdu.accessChoice,
            |self.pdu.reportVariableScopes|,
            |self.pdu.reportVariableDomains|,
            |self.pdu.reportVariableNames|,
            self.pdu.resultCount,
            self.pdu.failureCount,
            |self.pdu.reportResultChoices|,
            |self.pdu.reportResultErrors|,
            |self.pdu.reportResultRaws|,
            *self.pdu.reportVariableNames.at(0),
            *self.pdu.reportVariableNames.at(1),
            *self.pdu.reportVariableNames.at(2),
            *self.pdu.reportResultChoices.at(0),
            *self.pdu.reportResultChoices.at(1),
            *self.pdu.reportResultChoices.at(2),
            *self.pdu.reportResultErrors.at(0),
            *self.pdu.reportResultErrors.at(1),
            *self.pdu.reportResultErrors.at(2),
            *self.pdu.reportResultIntegerValues.at(0),
            *self.pdu.reportResultIntegerValues.at(1),
            *self.pdu.reportResultIntegerValues.at(2),
            *self.pdu.reportResultStringValues.at(0),
            *self.pdu.reportResultStringValues.at(1),
            *self.pdu.reportResultStringValues.at(2)
        );
    }
};

public type CorrelationCase = unit {
    request: ICCP_MMS::MMSpdu;
    response: ICCP_MMS::MMSpdu;

    on %done {
        if (
            self.request.pduType !=
                ICCP_MMS_TYPES::TopLevelPDU::CONFIRMED_REQUEST ||
            self.response.pduType !=
                ICCP_MMS_TYPES::TopLevelPDU::CONFIRMED_RESPONSE ||
            self.request.invokeId != self.response.invokeId
        )
            throw "MMS request and response invoke IDs do not correlate";

        print "invoke=%d request_service=%d response_service=%d" % (
            self.request.invokeId,
            self.request.serviceTag,
            self.response.serviceTag
        );
    }
};

public type PointMetadataCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        print "type=%d components=%d choices=%d/%d/%d integers=%d values=%d/%d flagsLength=%d timestamp=%d" % (
            self.pdu.firstResultChoice,
            self.pdu.firstResultComponentCount,
            self.pdu.firstResultFirstChoice,
            self.pdu.firstResultSecondChoice,
            self.pdu.firstResultThirdChoice,
            self.pdu.firstResultComponentIntegerCount,
            self.pdu.firstResultFirstInteger,
            self.pdu.firstResultSecondInteger,
            |self.pdu.firstResultFlagsRaw|,
            self.pdu.firstResultTimestampValue
        );
    }
};

public type PointShapeCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        local top0: uint64 = |self.pdu.pointComponentChoices| > 0 ?
            self.pdu.pointComponentChoices[0] : 0;
        local top1: uint64 = |self.pdu.pointComponentChoices| > 1 ?
            self.pdu.pointComponentChoices[1] : 0;
        local top2: uint64 = |self.pdu.pointComponentChoices| > 2 ?
            self.pdu.pointComponentChoices[2] : 0;
        local top3: uint64 = |self.pdu.pointComponentChoices| > 3 ?
            self.pdu.pointComponentChoices[3] : 0;
        local nested0: uint64 = |self.pdu.pointNestedChoices| > 0 ?
            self.pdu.pointNestedChoices[0] : 0;
        local nested1: uint64 = |self.pdu.pointNestedChoices| > 1 ?
            self.pdu.pointNestedChoices[1] : 0;
        local nestedValue0: int64 = |self.pdu.pointNestedIntegerValues| > 0 ?
            self.pdu.pointNestedIntegerValues[0] : 0;
        local nestedValue1: int64 = |self.pdu.pointNestedIntegerValues| > 1 ?
            self.pdu.pointNestedIntegerValues[1] : 0;
        print "top=%d choices=%d/%d/%d/%d nestedIndex=%d nested=%d/%d values=%d/%d" % (
            |self.pdu.pointComponentChoices|,
            top0, top1, top2, top3,
            self.pdu.pointNestedComponentIndex,
            nested0, nested1, nestedValue0, nestedValue1
        );
    }
};

public type TransferReportCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        print "access=%d variables=%d scope=%d domain=%s name=%s results=%d type=%d components=%d choices=%d/%d value=%s flagsLength=%d" % (
            self.pdu.accessChoice,
            self.pdu.variableCount,
            self.pdu.firstVariableScope,
            self.pdu.firstVariableDomain,
            self.pdu.firstVariableName,
            self.pdu.resultCount,
            self.pdu.firstResultChoice,
            self.pdu.firstResultComponentCount,
            self.pdu.firstResultFirstChoice,
            self.pdu.firstResultSecondChoice,
            self.pdu.firstResultFloatingValue,
            |self.pdu.firstResultFlagsRaw|
        );
    }
};

# Offline comparison surface for the independent MMS InformationReport
# oracle. Records remain in the quarantined validation directory; independent
# fingerprints avoid copying captured raw values into aggregate summaries.
public type InformationReportOracleStream = unit {
    var reportCount: uint64 = 0;

    pdus: ICCP_MMS::MMSpdu[] &eod foreach {
        if (
            $$.pduType == ICCP_MMS_TYPES::TopLevelPDU::UNCONFIRMED &&
            $$.unconfirmedServiceTag == 0
        ) {
            self.reportCount += 1;
            print "R\t%d\t%d\t%d\t%d\t%s\t%s\t%d\t%s\t%s\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d" % (
                self.reportCount,
                $$.accessChoice,
                $$.variableCount,
                $$.firstVariableScope,
                $$.firstVariableDomain,
                $$.firstVariableName,
                $$.namedListScope,
                $$.namedListDomain,
                $$.namedListName,
                $$.resultCount,
                $$.failureCount,
                $$.firstResultChoice,
                |$$.firstResultRaw|,
                oracleHash($$.firstResultRaw, 257, 4294967291),
                oracleHash($$.firstResultRaw, 263, 4294967279),
                oracleHash($$.firstResultRaw, 269, 4294967231),
                $$.firstResultComponentIntegerCount,
                $$.firstResultFirstInteger,
                $$.firstResultSecondInteger,
                $$.firstResultComponentCount,
                $$.firstResultFirstChoice,
                $$.firstResultSecondChoice,
                $$.firstResultThirdChoice,
                $$.firstResultIntegerValue,
                |$$.firstResultFlagsRaw|,
                oracleHash($$.firstResultFlagsRaw, 257, 4294967291),
                oracleHash($$.firstResultFlagsRaw, 263, 4294967279),
                oracleHash($$.firstResultFlagsRaw, 269, 4294967231),
                $$.firstResultTimestampValue
            );

            local index: uint64 = 0;
            while (index < |$$.reportResultChoices|) {
                print "V\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d" % (
                    self.reportCount,
                    index,
                    $$.reportResultChoices[index],
                    $$.reportResultErrors[index],
                    |$$.reportResultRaws[index]|,
                    oracleHash($$.reportResultRaws[index], 257, 4294967291),
                    oracleHash($$.reportResultRaws[index], 263, 4294967279),
                    oracleHash($$.reportResultRaws[index], 269, 4294967231)
                );
                index += 1;
            }
        }
    }
};

public type IdentifyOracleStream = unit {
    var identifyCount: uint64 = 0;

    pdus: ICCP_MMS::MMSpdu[] &eod foreach {
        if (
            $$.serviceTag == 2 &&
            (
                $$.pduType == ICCP_MMS_TYPES::TopLevelPDU::CONFIRMED_REQUEST ||
                $$.pduType == ICCP_MMS_TYPES::TopLevelPDU::CONFIRMED_RESPONSE
            )
        ) {
            self.identifyCount += 1;
            print "I\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%s" % (
                self.identifyCount,
                cast<uint64>($$.pduType),
                $$.invokeId,
                |$$.identifyVendorRaw|,
                oracleHash($$.identifyVendorRaw, 257, 4294967291),
                oracleHash($$.identifyVendorRaw, 263, 4294967279),
                oracleHash($$.identifyVendorRaw, 269, 4294967231),
                |$$.identifyModelRaw|,
                oracleHash($$.identifyModelRaw, 257, 4294967291),
                oracleHash($$.identifyModelRaw, 263, 4294967279),
                oracleHash($$.identifyModelRaw, 269, 4294967231),
                |$$.identifyRevisionRaw|,
                oracleHash($$.identifyRevisionRaw, 257, 4294967291),
                oracleHash($$.identifyRevisionRaw, 263, 4294967279),
                oracleHash($$.identifyRevisionRaw, 269, 4294967231),
                $$.identifyAbstractSyntaxCount,
                $$.identifyFirstAbstractSyntax
            );
        }
    }
};

public type TransferSetMetadataCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        print "type=%s service=%d access=%d list=%d/%s/%s variables=%d first=%d/%s/%s deletable=%s delete=%d names=%d matched=%d deleted=%d results=%d failures=%d" % (
            self.pdu.pduType,
            self.pdu.serviceTag,
            self.pdu.accessChoice,
            self.pdu.namedListScope,
            self.pdu.namedListDomain,
            self.pdu.namedListName,
            self.pdu.variableCount,
            self.pdu.namedListFirstVariableScope,
            self.pdu.namedListFirstVariableDomain,
            self.pdu.namedListFirstVariableName,
            self.pdu.mmsDeletable,
            self.pdu.deleteScope,
            self.pdu.nameCount,
            self.pdu.numberMatched,
            self.pdu.numberDeleted,
            self.pdu.resultCount,
            self.pdu.failureCount
        );
    }
};

public type FallbackCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        print "type=%s service=%d required=%s decoded=%s raw_length=%d" % (
            self.pdu.pduType,
            self.pdu.serviceTag,
            self.pdu.iccpRequiredService,
            self.pdu.semanticDecoded,
            |self.pdu.serviceBody|
        );
    }
};

public type ControlWriteCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        print "choice=%d rawLength=%d integer=%d floating=%s" % (
            self.pdu.writeFirstDataChoice,
            |self.pdu.writeFirstDataRaw|,
            self.pdu.writeFirstDataIntegerValue,
            self.pdu.writeFirstDataFloatingValue
        );
    }
};

public type WriteEvidenceCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        print "targetsKnown=%s targets=%d values=%d results=%d success=%d failure=%d" % (
            self.pdu.writeTargetCountKnown,
            self.pdu.writeTargetCount,
            self.pdu.writeValueCount,
            self.pdu.resultCount,
            self.pdu.successCount,
            self.pdu.failureCount
        );

        local index: uint64 = 0;
        while (index < |self.pdu.writeTargetNames|) {
            print "target[%d]=%d/%s/%s" % (
                index,
                self.pdu.writeTargetScopes[index],
                self.pdu.writeTargetDomains[index],
                self.pdu.writeTargetNames[index]
            );
            index += 1;
        }

        index = 0;
        while (index < |self.pdu.writeValueChoices|) {
            print "value[%d]=%d/%d/%d/%d/%s/%s/%s" % (
                index,
                self.pdu.writeValueChoices[index],
                |self.pdu.writeValueRaws[index]|,
                oracleHash(
                    self.pdu.writeValueRaws[index],
                    257,
                    65521
                ),
                self.pdu.writeValueIntegerValues[index],
                self.pdu.writeValueFloatingValues[index],
                self.pdu.writeValueBooleanValues[index],
                self.pdu.writeValueStringValues[index]
            );
            index += 1;
        }

        index = 0;
        while (index < |self.pdu.writeResultErrors|) {
            print "result[%d]=%s/%d" % (
                index,
                self.pdu.writeResultSuccesses[index],
                self.pdu.writeResultErrors[index]
            );
            index += 1;
        }
    }
};

public type ProtocolConfirmationCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        print "recognized=%s decoded=%s confirmation=%s" % (
            self.pdu.recognized,
            self.pdu.semanticDecoded,
            ICCP_MMS::protocolConfirmationIsValid(
                self.pdu.recognized,
                self.pdu.semanticDecoded
            )
        );
    }
};
