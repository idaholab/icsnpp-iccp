module ICCP_MMS_TEST;

import spicy;
import ICCP_MMS;
import ICCP_MMS_TYPES;
import ICCP_BER;

function oracleHash(value: bytes, multiplier: uint64, modulus: uint64): uint64 {
    local hashValue: uint64 = 0;
    local offset: uint64 = 0;
    while (offset < |value|) {
        hashValue = (
            hashValue * multiplier + uint64(*value.at(offset))
        ) % modulus;
        offset += 1;
    }
    return hashValue;
}

public type PDUCase = unit {
    pdu: ICCP_MMS::MMSpdu;

    on %done {
        print "type=%s recognized=%s decoded=%s constructed=%s length=%d body=%s" % (
            self.pdu.pduType,
            self.pdu.recognized,
            self.pdu.semanticDecoded,
            self.pdu.identifier.first.constructed,
            self.pdu.bodyLength,
            self.pdu.body
        );
    }
};

