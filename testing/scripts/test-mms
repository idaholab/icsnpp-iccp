nestedTypeDescriptionHex() {
    python3 - "$1" <<'PY'
import sys


def encode_length(length):
    if length < 128:
        return bytes([length])
    encoded = length.to_bytes((length.bit_length() + 7) // 8, "big")
    return bytes([0x80 + len(encoded)]) + encoded


def tlv(tag, value):
    return bytes([tag]) + encode_length(len(value)) + value


value = bytes.fromhex("850101")
for _ in range(int(sys.argv[1])):
    value = tlv(0xA1, bytes.fromhex("810101") + tlv(0xA2, value))
print(value.hex())
PY
}

twoStructuredForestHex() {
    python3 - "$1" <<'PY'
import sys


def encode_length(length):
    if length < 128:
        return bytes([length])
    encoded = length.to_bytes((length.bit_length() + 7) // 8, "big")
    return bytes([0x80 + len(encoded)]) + encoded


def tlv(tag, value):
    return bytes([tag]) + encode_length(len(value)) + value


child_count = int(sys.argv[1])
structured = tlv(0xA2, bytes.fromhex("a100") * child_count)
print(tlv(0x30, structured + structured).hex())
PY
}

mixedAccessResultForestHex() {
    python3 - "$1" <<'PY'
import sys


def encode_length(length):
    if length < 128:
        return bytes([length])
    encoded = length.to_bytes((length.bit_length() + 7) // 8, "big")
    return bytes([0x80 + len(encoded)]) + encoded


def tlv(tag, value):
    return bytes([tag]) + encode_length(len(value)) + value


failure_count = int(sys.argv[1])
failures = bytes.fromhex("800100") * failure_count
structured = tlv(0xA2, bytes.fromhex("a100") * 2047)
print(tlv(0x30, failures + structured).hex())
PY
}

runInformationReportOracleBudgetTest() {
    python3 - \
        "${projectDir}/testing/scripts/information-report-oracle.py" <<'PY'
import importlib.util
import pathlib
import sys


oracle_path = pathlib.Path(sys.argv[1])
spec = importlib.util.spec_from_file_location(
    "iccp_information_report_oracle", oracle_path
)
if spec is None or spec.loader is None:
    raise SystemExit("could not load InformationReport oracle")
oracle = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = oracle
spec.loader.exec_module(oracle)


def encode_length(length):
    if length < 128:
        return bytes([length])
    encoded = length.to_bytes((length.bit_length() + 7) // 8, "big")
    return bytes([0x80 + len(encoded)]) + encoded


def tlv(tag, value):
    return bytes([tag]) + encode_length(len(value)) + value


def fields(failure_count):
    failures = bytes.fromhex("800100") * failure_count
    structured = tlv(0xA2, bytes.fromhex("a100") * 2047)
    return oracle.read_children(failures + structured)


budget = [0]
for field in fields(2048):
    oracle.decode_access_result(field, budget)
if budget[0] != oracle.MAX_ELEMENT_COUNT:
    raise SystemExit(
        f"InformationReport oracle counted {budget[0]} nodes, "
        f"expected {oracle.MAX_ELEMENT_COUNT}"
    )

try:
    overflow_budget = [0]
    for field in fields(2049):
        oracle.decode_access_result(field, overflow_budget)
except oracle.OracleError as exc:
    if "MMS Data elements exceed bound" not in str(exc):
        raise
else:
    raise SystemExit("InformationReport oracle accepted a 4,097-node forest")
PY

    passCount=$((passCount + 1))
}

twoVariableAlternateForestsHex() {
    python3 - "$1" <<'PY'
import sys


def encode_length(length):
    if length < 128:
        return bytes([length])
    encoded = length.to_bytes((length.bit_length() + 7) // 8, "big")
    return bytes([0x80 + len(encoded)]) + encoded


def tlv(tag, value):
    return bytes([tag]) + encode_length(len(value)) + value


selection_count = int(sys.argv[1])
variable = bytes.fromhex("a003800176")
alternate_access = tlv(0xA5, bytes.fromhex("810141") * selection_count)
entry = tlv(0x30, variable + alternate_access)
print(tlv(0xA0, entry + entry).hex())
PY
}

