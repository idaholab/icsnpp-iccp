#!/usr/bin/env bash

set -euo pipefail

scriptDir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
projectDir="$(cd "${scriptDir}/../.." && pwd)"
testBuildDir="$(mktemp -d "${TMPDIR:-/tmp}/iccp-mms-tests.XXXXXX")"
testPlugin="${testBuildDir}/mms-tests.hlto"

trap 'rm -rf "${testBuildDir}"' EXIT
export HILTI_JIT_PARALLELISM="${HILTI_JIT_PARALLELISM:-2}"
spicyc -j -o "${testPlugin}" \
    "${projectDir}/testing/spicy/mms_driver.spicy" \
    "${projectDir}/analyzer/mms.spicy" \
    "${projectDir}/analyzer/mms_types.spicy" \
    "${projectDir}/analyzer/ber.spicy"

passCount=0

# ISO 9506-1 fixes ParameterSupportOptions at 18 bits and
# ServiceSupportOptions at 93 bits. The first octet of each IMPLICIT BIT STRING
# content is the unused-bit count.
initDetailHex="a418800101810406f00000820d03aa5500000000000000000000"
initRequestHex="a820810105820105${initDetailHex}"
initResponseHex="a92780020400810105820105830110${initDetailHex}"

runValid() {
    local hexInput="$1"
    local expected="$2"
    local actual

    actual="$(
        printf '%s' "${hexInput}" |
            xxd -r -p |
            spicy-driver -p "ICCP_MMS_TEST::PDUCase" "${testPlugin}"
    )"

    if [[ "${actual}" != "${expected}" ]]; then
        echo "unexpected MMS output for ${hexInput}" >&2
        echo "expected: ${expected}" >&2
        echo "actual:   ${actual}" >&2
        exit 1
    fi

    passCount=$((passCount + 1))
}

runInvalid() {
    local hexInput="$1"
    local expectedError="$2"
    local output

    if output="$(
        printf '%s' "${hexInput}" |
            xxd -r -p |
            spicy-driver -p "ICCP_MMS_TEST::PDUCase" \
                "${testPlugin}" 2>&1
    )"; then
        echo "invalid MMS input unexpectedly parsed: ${hexInput}" >&2
        exit 1
    fi

    if ! grep -q "${expectedError}" <<<"${output}"; then
        echo "unexpected MMS error for ${hexInput}" >&2
        echo "expected error containing: ${expectedError}" >&2
        echo "actual output: ${output}" >&2
        exit 1
    fi

    passCount=$((passCount + 1))
}

runCaseValid() {
    local parser="$1"
    local hexInput="$2"
    local expected="$3"
    local actual

    actual="$(
        printf '%s' "${hexInput}" |
            xxd -r -p |
            spicy-driver -p "${parser}" "${testPlugin}"
    )"

    if [[ "${actual}" != "${expected}" ]]; then
        echo "unexpected MMS output for ${parser} ${hexInput}" >&2
        echo "expected: ${expected}" >&2
        echo "actual:   ${actual}" >&2
        exit 1
    fi

    passCount=$((passCount + 1))
}

runCaseInvalid() {
    local parser="$1"
    local hexInput="$2"
    local expectedError="$3"
    local output

    if output="$(
        printf '%s' "${hexInput}" |
            xxd -r -p |
            spicy-driver -p "${parser}" "${testPlugin}" 2>&1
    )"; then
        echo "invalid MMS input unexpectedly parsed by ${parser}: ${hexInput}" >&2
        exit 1
    fi

    if ! grep -q "${expectedError}" <<<"${output}"; then
        echo "unexpected MMS error for ${parser} ${hexInput}" >&2
        echo "expected error containing: ${expectedError}" >&2
        echo "actual output: ${output}" >&2
        exit 1
    fi

    passCount=$((passCount + 1))
}

runValid "a005020101a300" \
    "type=TopLevelPDU::CONFIRMED_REQUEST recognized=true decoded=false constructed=true length=5 body=\\x02\\x01\\x01\\xa3\\x00"
runValid "a1050201018300" \
    "type=TopLevelPDU::CONFIRMED_RESPONSE recognized=true decoded=false constructed=true length=5 body=\\x02\\x01\\x01\\x83\\x00"
runValid "a20a800101a205a003800102" \
    "type=TopLevelPDU::CONFIRMED_ERROR recognized=true decoded=true constructed=true length=10 body=\\x80\\x01\\x01\\xa2\\x05\\xa0\\x03\\x80\\x01\\x02"
