    "type=TopLevelPDU::INITIATE_REQUEST recognized=true decoded=true constructed=true length=32 body=\\x81\\x01\\x05\\x82\\x01\\x05\\xa4\\x18\\x80\\x01\\x01\\x81\\x04\\x06\\xf0\\x00\\x00\\x82\\x0d\\x03\\xaaU\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00"
