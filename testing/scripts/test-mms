runValid "8c00" "type=TopLevelPDU::CONCLUDE_RESPONSE recognized=true decoded=true constructed=false length=0 body="
runValid "ad05a003800102" \
    "type=TopLevelPDU::CONCLUDE_ERROR recognized=true decoded=true constructed=true length=5 body=\\xa0\\x03\\x80\\x01\\x02"

runValid "8e02aabb" \
    "type=TopLevelPDU::UNKNOWN recognized=false decoded=false constructed=false length=2 body=\\xaa\\xbb"
runValid "3000" \
    "type=TopLevelPDU::UNKNOWN recognized=false decoded=false constructed=true length=0 body="

runInvalid "8000" "requires constructed encoding"
runInvalid "a500" "requires primitive encoding"
runInvalid "8b0100" "must have an empty body"
runInvalid "a0030102" "expected 3 bytes"
