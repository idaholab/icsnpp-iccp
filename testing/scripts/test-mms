# Compare the independent MMS oracle with the production grammar over a
# deterministic full-stack report. All detailed records stay in a temporary
# directory; only the equality result is published by this test.
oracleTestDir="${testBuildDir}/oracle"
mkdir -p "${oracleTestDir}"
"${scriptDir}/generate-synthetic-pcap" \
    "${oracleTestDir}/input.pcap" direct-mms-negotiated > /dev/null
python3 "${scriptDir}/extract-local-mms.py" \
    "${oracleTestDir}/input.pcap" "${oracleTestDir}/mms.pcap" \
    "${oracleTestDir}/extract.summary" > /dev/null
python3 "${scriptDir}/information-report-oracle.py" \
    "${oracleTestDir}/mms.pcap" "${oracleTestDir}/independent.tsv" \
    "${oracleTestDir}/oracle.summary" \
    --reports "${oracleTestDir}/reports.bin" > /dev/null
spicy-driver -p "ICCP_MMS_TEST::InformationReportOracleStream" \
    -f "${oracleTestDir}/reports.bin" "${testPlugin}" \
    > "${oracleTestDir}/production.tsv"
cmp "${oracleTestDir}/independent.tsv" "${oracleTestDir}/production.tsv"

if [[ "$(awk -F '\t' '$1 == "information_report.reports" {print $2}' \
    "${oracleTestDir}/oracle.summary")" != 1 ]]; then
    echo "independent oracle did not decode the synthetic InformationReport" >&2
    exit 1
fi

echo "independent InformationReport semantic comparison passed"

"${scriptDir}/generate-synthetic-pcap" \
    "${oracleTestDir}/identify-input.pcap" identify > /dev/null
python3 "${scriptDir}/extract-local-mms.py" \
    "${oracleTestDir}/identify-input.pcap" \
    "${oracleTestDir}/identify-mms.pcap" \
    "${oracleTestDir}/identify-extract.summary" > /dev/null
python3 "${scriptDir}/identify-oracle.py" \
    "${oracleTestDir}/identify-mms.pcap" \
    "${oracleTestDir}/identify-independent.tsv" \
    "${oracleTestDir}/identify-oracle.summary" \
    --pdus "${oracleTestDir}/identify-pdus.bin" > /dev/null
spicy-driver -p "ICCP_MMS_TEST::IdentifyOracleStream" \
    -f "${oracleTestDir}/identify-pdus.bin" "${testPlugin}" \
    > "${oracleTestDir}/identify-production.tsv"
cmp "${oracleTestDir}/identify-independent.tsv" \
    "${oracleTestDir}/identify-production.tsv"

if [[ "$(awk -F '\t' '$1 == "identify.requests" {print $2}' \
    "${oracleTestDir}/identify-oracle.summary")" != 1 ]] || \
   [[ "$(awk -F '\t' '$1 == "identify.responses" {print $2}' \
    "${oracleTestDir}/identify-oracle.summary")" != 1 ]]; then
    echo "independent oracle did not decode the synthetic Identify exchange" >&2
    exit 1
fi

echo "independent Identify semantic comparison passed"

echo "${passCount} MMS runtime tests passed"
