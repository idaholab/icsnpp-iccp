    "type=TopLevelPDU::UNCONFIRMED recognized=true decoded=false constructed=true length=2 body=\\x80\\x00"
runValid "a1050201018b00" \
    "type=TopLevelPDU::CONFIRMED_RESPONSE recognized=true decoded=true constructed=true length=5 body=\\x02\\x01\\x01\\x8b\\x00"
runValid "a406800107850101" \
    "type=TopLevelPDU::REJECT recognized=true decoded=true constructed=true length=6 body=\\x80\\x01\\x07\\x85\\x01\\x01"
runValid "850101" "type=TopLevelPDU::CANCEL_REQUEST recognized=true decoded=true constructed=false length=1 body=\\x01"
runValid "860101" "type=TopLevelPDU::CANCEL_RESPONSE recognized=true decoded=true constructed=false length=1 body=\\x01"
runValid "a70a800109a105a003800102" \
    "type=TopLevelPDU::CANCEL_ERROR recognized=true decoded=true constructed=true length=10 body=\\x80\\x01\\x09\\xa1\\x05\\xa0\\x03\\x80\\x01\\x02"
