#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
scenario="${1:?usage: generate-malformed-pcap SCENARIO OUTPUT}"
output_pcap="${2:?usage: generate-malformed-pcap SCENARIO OUTPUT}"
fixture="${script_dir}/../traces/malformed/${scenario}.pcap"

if [[ ! -f "${fixture}" ]]; then
    echo "unknown malformed capture scenario: ${scenario}" >&2
    exit 2
fi

cp -- "${fixture}" "${output_pcap}"
