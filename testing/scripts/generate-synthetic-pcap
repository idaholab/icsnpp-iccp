#!/usr/bin/env bash

set -euo pipefail

if [[ "$#" -lt 1 || "$#" -gt 2 ]]; then
    echo "usage: $0 OUTPUT.pcap [initiate|association-wrong-mms|identify|identify-unmatched|identify-direction-mismatch|unknown-service|private-object|release|abort|direct-mms-negotiated|direct-mms-type-discovery|direct-mms-read-classification|direct-mms-extended-classification|direct-mms-supplemental-classification|direct-mms-control-classification|direct-mms-select-classification|direct-mms-tag-classification|direct-mms-ds-transfer-parameters|direct-mms-data-set-validation|direct-mms-aggregate-identity|direct-mms-bilateral-domain-ownership|direct-mms-device-action|direct-mms-information-message|direct-mms-rejected|direct-mms-unmatched|direct-mms-midstream|direct-mms-multi-result|direct-mms-result-mismatch|direct-mms-incomplete-identity|direct-mms-untracked-list|direct-mms-midstream-reverse|direct-mms-midstream-malformed|direct-mms-midstream-acse|direct-mms-unknown-context|direct-mms-capture-boundary|direct-mms-truncated-tail|direct-mms-invalid-truncated-tail|direct-mms-gap-recovery|direct-mms-gap-tail|direct-mms-gap-terminal-negotiated|direct-mms-incomplete-cotp-boundary-peer|direct-mms-prebaseline-ack|direct-mms-partial-initial-ack|direct-mms-partial-initial-ack-release]" >&2
    exit 2
fi

outputPcap="$1"
fixture="${2:-initiate}"
temporaryHexdump="$(mktemp)"
temporaryFullPcap=""
trap 'rm -f "${temporaryHexdump}"; if [[ -n "${temporaryFullPcap}" ]]; then rm -f "${temporaryFullPcap}"; fi' EXIT

# Normal association fixtures use Session CONNECT/ACCEPT carrying Presentation
# CP/CPA values.  Their user data contains AARQ/InitiateRequest and the matching
# accepted AARE/InitiateResponse on separately negotiated ACSE (1) and MMS (3)
# contexts.  Every inner value is also covered by a focused parser regression.
directMms=false
directNegotiated=false
directRejected=false
directUnmatched=false
gapRecovery=false
gapTail=false
gapTerminalNegotiated=false
incompleteCotpBoundaryPeer=false
prebaselineAck=false
partialInitialAck=false
partialInitialAckRelease=false
midstreamReverse=false
midstreamMalformed=false
midstreamAcse=false
unknownContext=false
captureBoundary=false
truncatedTail=false
invalidTruncatedTail=false
identifyExchange=false
identifyUnmatched=false
identifyDirectionMismatch=false
typeDiscovery=false
readClassification=false
extendedClassification=false
supplementalClassification=false
controlClassification=false
selectClassification=false
tagClassification=false
dsTransferParameters=false
dataSetValidation=false
aggregateIdentity=false
bilateralDomainOwnership=false
deviceAction=false
informationMessage=false
associationWrongMms=false
case "${fixture}" in
    initiate|release|abort)
        mmsHex="a820810105820105a418800101810406f00000820d03aa5500000000000000000000"
        ;;
    association-wrong-mms)
        # A valid confirmed Read request placed in otherwise valid AARQ user
        # information.  ACSE must reject it before any nested MMS hook fires.
        mmsHex="a015020102a410a10ea00c300aa0088006506f696e7431"
        associationWrongMms=true
        ;;
    unknown-service)
        mmsHex="a008020101bf4d02aabb"
        ;;
    identify)
        mmsHex="a0050201018200"
        directMms=true
        directNegotiated=true
        identifyExchange=true
        ;;
    identify-unmatched)
        mmsHex="a0050201018200"
        directMms=true
        directNegotiated=true
        identifyExchange=true
        identifyUnmatched=true
        ;;
    identify-direction-mismatch)
        mmsHex="a0050201018200"
        directMms=true
        directNegotiated=true
        identifyExchange=true
        identifyDirectionMismatch=true
        ;;
    direct-mms-type-discovery)
        # GetVariableAccessAttributes(Point1), followed by an inline
        # TypeDescription response and an explicit InformationReport. Exact
        # TASE.2 typing is supplied separately by the test's site mapping.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        typeDiscovery=true
        ;;
    direct-mms-read-classification)
        # Attribute discovery for Point1 followed by a correlated Read. Exact
        # Data_RealQ typing is supplied separately by the test's site mapping.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        typeDiscovery=true
        readClassification=true
        ;;
    direct-mms-extended-classification)
        # The mandatory startup Read of a standardized object is affirmative
        # TASE.2 evidence even when no optional attribute-discovery request is
        # present. Follow it with Point1 type discovery and a supported nested
        # TimeStampExtended value in a correlated Read.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        typeDiscovery=true
        readClassification=true
        extendedClassification=true
        ;;
    direct-mms-supplemental-classification)
        # Establish affirmative TASE.2 evidence before exact supplemental
        # State type discovery and a correlated extended-timestamp Read.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        typeDiscovery=true
        readClassification=true
        supplementalClassification=true
        ;;
    direct-mms-control-classification)
        # Verified association and exact type discovery followed by an Operate
        # Write carrying one Control_Command value.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        controlClassification=true
        ;;
    direct-mms-select-classification)
        # Verified association and exact type discovery followed by a Select
        # Read of BREAKER_SBO returning a width-16 CheckBackID integer.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        selectClassification=true
        ;;
    direct-mms-tag-classification)
        # Verified association and exact Tag_Value type discovery followed by
        # Set Tag Write and Get Tag Read operations for BREAKER_TAG.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        tagClassification=true
        ;;
    direct-mms-ds-transfer-parameters)
        # Verified association and exact DSTransferSet type discovery followed
        # by a fully validated Start Transfer Write and confirmation.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        dsTransferParameters=true
        ;;
    direct-mms-data-set-validation)
        # Verified association followed by positive Define responses for one
        # valid list and three profile-invalid lists, then a duplicate Define
        # and a report proving the original membership was preserved.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        dataSetValidation=true
        ;;
    direct-mms-aggregate-identity)
        # Verified association followed by direct fixed Information Message
        # buffer references, a GetNameList response, and a named-list Write.
        # Only explicit ObjectNames may reach aggregate object policy.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        aggregateIdentity=true
        ;;
    direct-mms-bilateral-domain-ownership)
        # On one dual-use association, prove that a successful Bilateral Table
        # bootstrap belongs only to the endpoint that served its Read result.
        mmsHex=""
        directMms=true
        bilateralDomainOwnership=true
        ;;
    direct-mms-device-action)
        # Verified association followed by an exact Device Success
        # EventNotification using the supported Device-action convention.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        deviceAction=true
        ;;
    direct-mms-information-message)
        # Verified association followed by a validated Information Message
        # named-list/report mapping.
        mmsHex="a021020109a41ca11aa0183016a0148012537570706f727465645f4665617475726573"
        directMms=true
        directNegotiated=true
        informationMessage=true
        ;;
    private-object)
        mmsHex="a017020101a612a010800e56656e646f725f50726976617465"
        ;;
    direct-mms-negotiated)
        mmsHex="a005020101a300"
        directMms=true
        directNegotiated=true
        ;;
    direct-mms-rejected)
        mmsHex="a005020101a300"
        directMms=true
        directRejected=true
        ;;
    direct-mms-unmatched)
        mmsHex="a005020101a300"
        directMms=true
        directUnmatched=true
        ;;
    direct-mms-midstream)
        mmsHex="a005020101a300"
        directMms=true
        ;;
    direct-mms-multi-result)
        # Explicit variable/result pairing: integer success, data-access
        # failure, and VisibleString success.
        mmsHex="a32ea02ca01e3008a0068004766172313008a0068004766172323008a006800476617233a00a85012a8001038a026f6b"
        directMms=true
        ;;
    direct-mms-result-mismatch)
        # Two explicit variables and three results must retain evidence while
        # declining positional object pairing.
        mmsHex="a324a022a0143008a0068004766172313008a006800476617232a00a85012a8001038a026f6b"
        directMms=true
        ;;
    direct-mms-incomplete-identity)
        # Matching cardinality with a standards-valid address-based
        # VariableSpecification has no ObjectName and must not authorize a
        # result-to-object association.  `invalidated` is intentionally not
        # used here because ISO 9506 permits it only in response/confirm
        # primitives, not an unconfirmed InformationReport indication.
        mmsHex="a310a00ea0073005a103800101a00385012a"
        directMms=true
        ;;
    direct-mms-untracked-list)
        # A named-list report without confirmed membership state must not
        # invent the identity of either ordered result.
        mmsHex="a311a00fa1058003766172a006800103850101"
        directMms=true
        ;;
    direct-mms-midstream-reverse)
        mmsHex="a1050201018300"
        directMms=true
        midstreamReverse=true
        ;;
    direct-mms-midstream-malformed)
        mmsHex="a005020101a300"
        directMms=true
        midstreamMalformed=true
        ;;
    direct-mms-midstream-acse)
        mmsHex="a005020101a300"
        directMms=true
        midstreamAcse=true
        ;;
    direct-mms-unknown-context)
        mmsHex="a005020101a300"
        directMms=true
        unknownContext=true
        ;;
    direct-mms-capture-boundary)
        mmsHex="a005020101a300"
        directMms=true
        captureBoundary=true
        ;;
    direct-mms-truncated-tail)
        # A valid record followed immediately by a plausible but incomplete
        # TPKT. Unlike capture-boundary, no leading garbage may pre-mark the
        # direction as a parser-recovery episode.
        mmsHex="a005020101a300"
        directMms=true
        truncatedTail=true
        ;;
    direct-mms-invalid-truncated-tail)
        # The next TPKT is incomplete, but its captured COTP LI already makes
        # the inner record impossible. This must be parse recovery, not an
        # ordinary incomplete-record observation.
        mmsHex="a005020101a300"
        directMms=true
        invalidTruncatedTail=true
        ;;
    direct-mms-gap-recovery)
        mmsHex="a005020101a300"
        directMms=true
        gapRecovery=true
        ;;
    direct-mms-gap-tail)
        mmsHex="a005020101a300"
        directMms=true
        gapTail=true
        ;;
    direct-mms-gap-terminal-negotiated)
        mmsHex="a0050201018200"
        directMms=true
        gapTerminalNegotiated=true
        ;;
    direct-mms-incomplete-cotp-boundary-peer)
        # Establish a real association, then expose only a replacement CR's
        # TPKT/LI/type prefix before peer DT traffic. The missing CR suffix is
        # a capture-boundary condition, not permission to retain the previous
        # transport epoch or its Presentation/policy trust.
        mmsHex="a0050201018200"
        directMms=true
        incompleteCotpBoundaryPeer=true
        ;;
    direct-mms-prebaseline-ack)
        # The first originator TPKT is captured only after the responder has
        # acknowledged it. Zeek must treat that already-ACKed segment as late
        # sequence space, report a leading gap, and resume at the next
        # in-order TPKT instead of fabricating delivery of the late record.
        mmsHex="a311a00fa1058003766172a006800103850101"
        directMms=true
        prebaselineAck=true
        ;;
    direct-mms-partial-initial-ack|direct-mms-partial-initial-ack-release)
        # One byte of the first later-seen payload is already acknowledged.
        # Zeek's partial-connection TCP path withholds the unacknowledged suffix
        # at capture end, even though that suffix is one complete TPKT.
        mmsHex="a0050201078200"
        directMms=true
        partialInitialAck=true
        if [[ "${fixture}" == "direct-mms-partial-initial-ack-release" ]]; then
            partialInitialAckRelease=true
        fi
        ;;
    *)
        echo "unknown synthetic fixture: ${fixture}" >&2
        exit 2
        ;;
esac

hexLength() {
    printf '%02x' "$((${#1} / 2))"
}

tlv() {
    local tag="$1"
    local content="$2"
    local contentBytes="$((${#content} / 2))"
    local encodedLength
    if ((contentBytes < 128)); then
        encodedLength="$(printf '%02x' "${contentBytes}")"
    elif ((contentBytes <= 255)); then
        encodedLength="$(printf '81%02x' "${contentBytes}")"
    elif ((contentBytes <= 65535)); then
        encodedLength="$(printf '82%04x' "${contentBytes}")"
    else
        echo "BER fixture content is too large" >&2
        return 1
    fi
    printf '%s%s%s' "${tag}" "${encodedLength}" "${content}"
}

asciiHex() {
    printf '%s' "$1" | xxd -p -c 1024
}

# MMS TypeDescription helpers. Structure components contain an explicitly
# tagged TypeSpecification; GetVariableAccessAttributes in turn wraps the
# top-level TypeDescription in response field [2].
typeComponent() {
    tlv 30 "$(tlv a1 "$1")"
}

structureType() {
    tlv a2 "$(tlv a1 "$1")"
}

gvaTypeResponse() {
    tlv a1 "020101$(tlv a6 "800100$(tlv a2 "$1")")"
}

stackPresentation() {
    local sessionIdentifier="$1"
    local presentationHex="$2"
    local sessionParameters
    local sessionHex
    local transportHex
    local tpktLength

    sessionParameters="c1$(hexLength "${presentationHex}")${presentationHex}"
    if [[ "${sessionIdentifier}" == "0d" ||
          "${sessionIdentifier}" == "0e" ]]; then
        # Connect/Accept Item: protocol options=0 and protocol version=2;
        # Session Requirements: duplex.  These precede the user-data PI in the
        # increasing PI-code order required by X.225.
        sessionParameters="050613010016010214020002${sessionParameters}"
    elif [[ "${sessionIdentifier}" == "19" ]]; then
        # ABORT carries the Transport Disconnect PI before its user data.
        sessionParameters="110103${sessionParameters}"
    fi
    sessionHex="${sessionIdentifier}$(hexLength "${sessionParameters}")${sessionParameters}"
    transportHex="02f080${sessionHex}"
    tpktLength="$(printf '%04x' "$((${#transportHex} / 2 + 4))")"
    printf '0300%s%s' "${tpktLength}" "${transportHex}"
}

presentationPdv() {
    local contextId="$1"
    local directHex="$2"
    tlv 61 "$(tlv 30 "0201${contextId}$(tlv a0 "${directHex}")")"
}

stackDirectPayload() {
    local contextId="$1"
    local directHex="$2"
    local directPdv
    local directPresentation
    local directTransport
    local directLength

    directPdv="$(presentationPdv "${contextId}" "${directHex}")"
    directPresentation="${directPdv}"
    directTransport="02f0800100${directPresentation}"
    directLength="$(printf '%04x' "$((${#directTransport} / 2 + 4))")"
    printf '0300%s%s' "${directLength}" "${directTransport}"
}

stackDirectMms() {
    stackDirectPayload 03 "$1"
}

stackAcse() {
    stackDirectPayload 01 "$1"
}

associationInformation() {
    local mmsPayload="$1"
    local externalContent
    externalContent="06025101020103$(tlv a0 "${mmsPayload}")"
    tlv be "$(tlv 28 "${externalContent}")"
}

buildAssociationCp() {
    local initiateRequest="${1:-a820810105820105a418800101810406f00000820d03aa5500000000000000000000}"
    local contextDefinitions
    local aarq
    local normalMode

    contextDefinitions="300f0201010604520100013004060251013010020103060528ca220201300406025101"
    # ISO MMS application-context-version1 is 1.0.9506.2.3.
    aarq="$(tlv 60 "a107060528ca220203$(associationInformation "${initiateRequest}")")"
    normalMode="$(tlv a4 "${contextDefinitions}")$(presentationPdv 01 "${aarq}")"
    tlv 31 "a003800101$(tlv a2 "${normalMode}")"
}

buildAssociationCpa() {
    local initiateResponse="a92780020400810105820105830110a418800101810406f00000820d03aa5500000000000000000000"
    local contextResults
    local aare
    local normalMode

    contextResults="300780010081025101300780010081025101"
    aare="$(tlv 61 "a107060528ca220203a203020100a305a103020100$(associationInformation "${initiateResponse}")")"
    normalMode="$(tlv a5 "${contextResults}")$(presentationPdv 01 "${aare}")"
    tlv 31 "a003800101$(tlv a2 "${normalMode}")"
}

if [[ "${associationWrongMms}" == true ]]; then
    associationCp="$(buildAssociationCp "${mmsHex}")"
else
    associationCp="$(buildAssociationCp)"
fi
associationCpa="$(buildAssociationCpa)"

emitDirectionalPacket() {
    local direction="$1"
    local timestamp="$2"
    local packetHex="$3"

    printf '%s' "${packetHex}" | xxd -r -p | xxd -g 1 |
        sed "1s/^/${direction} ${timestamp} /" >> "${temporaryHexdump}"
    printf '\n' >> "${temporaryHexdump}"
}

emitRawPacket() {
    local timestamp="$1"
    local packetHex="$2"

    printf '%s' "${packetHex}" | xxd -r -p | xxd -g 1 |
        sed "1s/^/${timestamp} /" >> "${temporaryHexdump}"
    printf '\n' >> "${temporaryHexdump}"
}

buildRawTcpPacket() {
    local direction="$1"
    local sequence="$2"
    local acknowledgement="$3"
    local packetPayload="$4"
    local ethernetHeader
    local ipAddresses
    local tcpPorts
    local tcpFlags=$((0x18))
    local ipLength=$((40 + ${#packetPayload} / 2))
    local ipChecksumSum=$((0xdc0c + ipLength))

    if [[ -z "${packetPayload}" ]]; then
        tcpFlags=$((0x10))
    fi

    if [[ "${direction}" == I ]]; then
        ethernetHeader="0000000000020000000000010800"
        ipAddresses="0a0101010a020202"
        tcpPorts="c0000066"
    else
        ethernetHeader="0000000000010000000000020800"
        ipAddresses="0a0202020a010101"
        tcpPorts="0066c000"
    fi

    while ((ipChecksumSum > 0xffff)); do
        ipChecksumSum=$(((ipChecksumSum & 0xffff) +
                         (ipChecksumSum >> 16)))
    done

    printf '%s4500%04x000040004006%04x%s%s%08x%08x50%02x200000000000%s' \
        "${ethernetHeader}" "${ipLength}" "$(((~ipChecksumSum) & 0xffff))" \
        "${ipAddresses}" "${tcpPorts}" "${sequence}" "${acknowledgement}" \
        "${tcpFlags}" "${packetPayload}"
}

emitCotpHandshake() {
    # Normal full-stack associations begin with an ISO 8073 class-0 CR/CC.
    # The compact direct/midstream fixtures intentionally begin at COTP DT and
    # exercise capture-boundary recovery, so callers opt into this helper.
    emitDirectionalPacket I "2019-12-31T23:59:59.998000Z" \
        "0300000b06e00000000100"
    emitDirectionalPacket O "2019-12-31T23:59:59.999000Z" \
        "0300000b06d00001000200"
}

if [[ "${associationWrongMms}" == true ]]; then
    emitCotpHandshake
    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "$(stackPresentation 0d "${associationCp}")"
    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${gapTerminalNegotiated}" == true ]]; then
    # Establish a verified association, then remove the originator's final
    # segment while retaining a responder segment whose ACK proves the hole.
    # There is no later originator token to synchronize to. The gap must still
    # invalidate connection-scoped Presentation/policy trust before the peer's
    # post-gap InformationReport is decoded by inference.
    missingHex=""
    for ((index = 0; index < 256; index++)); do
        missingHex+="00"
    done

    emitCotpHandshake
    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "$(stackPresentation 0d "${associationCp}")"
    emitDirectionalPacket O "2020-01-01T00:00:00.001000Z" \
        "$(stackPresentation 0e "${associationCpa}")"
    emitDirectionalPacket I "2020-01-01T00:00:00.002000Z" \
        "$(stackDirectMms "${mmsHex}")"
    emitDirectionalPacket I "2020-01-01T00:00:00.003000Z" "${missingHex}"
    emitDirectionalPacket O "2020-01-01T00:00:00.004000Z" \
        "$(stackDirectMms 'a311a00fa1058003766172a006800103850101')"

    temporaryFullPcap="$(mktemp)"
    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${temporaryFullPcap}"
    editcap -F pcap -r "${temporaryFullPcap}" "${outputPcap}" \
        1 2 3 4 5 7
    exit 0
fi

if [[ "${incompleteCotpBoundaryPeer}" == true ]]; then
    # No FIN is synthesized. The originator's final segment carries a valid
    # TPKT header and the first two COTP octets of a replacement CR, but none
    # of its advertised fixed header. The following peer InformationReport is
    # deliberately complete: it must be rejected at COTP while reconnect is
    # required, before Presentation or MMS can reuse the old association.
    emitCotpHandshake
    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "$(stackPresentation 0d "${associationCp}")"
    emitDirectionalPacket O "2020-01-01T00:00:00.001000Z" \
        "$(stackPresentation 0e "${associationCpa}")"
    emitDirectionalPacket I "2020-01-01T00:00:00.002000Z" \
        "$(stackDirectMms "${mmsHex}")"
    emitDirectionalPacket I "2020-01-01T00:00:00.003000Z" \
        "0300000b06e0"
    emitDirectionalPacket O "2020-01-01T00:00:00.004000Z" \
        "$(stackDirectMms 'a311a00fa1058003766172a006800103850101')"

    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${prebaselineAck}" == true ]]; then
    # Begin with responder payload acknowledging an unseen 37-byte
    # originator record. An originator ACK-only packet establishes the reverse
    # sequence baseline at the missing range's start; the repeated responder
    # ACK then makes the leading gap reportable before the already-ACKed record
    # appears as a late retransmission. Only the following originator record,
    # whose sequence starts at the ACK boundary, is deliverable. Build raw
    # headers so the zero-length ACKs are represented exactly; -C in every
    # parser test deliberately ignores transport checksums.
    peerPayload="$(stackDirectMms 'a1050201098300')"
    latePayload="$(stackDirectMms "${mmsHex}")"
    nextPayload="$(stackDirectMms 'a0050201078200')"
    peerLength=$((${#peerPayload} / 2))
    lateLength=$((${#latePayload} / 2))

    emitRawPacket "2020-01-01T00:00:00.000000Z" \
        "$(buildRawTcpPacket O 0 "${lateLength}" "${peerPayload}")"
    emitRawPacket "2020-01-01T00:00:00.001000Z" \
        "$(buildRawTcpPacket I 0 "${peerLength}" '')"
    emitRawPacket "2020-01-01T00:00:00.002000Z" \
        "$(buildRawTcpPacket O "${peerLength}" "${lateLength}" '')"
    emitRawPacket "2020-01-01T00:00:00.003000Z" \
        "$(buildRawTcpPacket I 0 "${peerLength}" "${latePayload}")"
    emitRawPacket "2020-01-01T00:00:00.004000Z" \
        "$(buildRawTcpPacket I "${lateLength}" "${peerLength}" "${nextPayload}")"

    TZ=UTC text2pcap -q -F pcap -t ISO \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${partialInitialAck}" == true ]]; then
    # The direction's ACK-only packet establishes sequence 100 as Zeek's
    # partial-stream baseline. The peer then advances its ACK by exactly one
    # byte. A later payload overlaps that acknowledged byte and carries a
    # complete Identify TPKT in its unacknowledged suffix. Without another peer
    # ACK, the suffix remains buffered at EOF. The release variant adds only
    # that final ACK and proves the same suffix can then be recovered.
    identifyPayload="$(stackDirectMms "${mmsHex}")"
    overlappedPayload="00${identifyPayload}"
    overlappedLength=$((${#overlappedPayload} / 2))

    emitRawPacket "2020-01-01T00:00:00.000000Z" \
        "$(buildRawTcpPacket I 100 500 '')"
    emitRawPacket "2020-01-01T00:00:00.001000Z" \
        "$(buildRawTcpPacket O 500 101 '')"
    emitRawPacket "2020-01-01T00:00:00.002000Z" \
        "$(buildRawTcpPacket I 100 500 "${overlappedPayload}")"

    if [[ "${partialInitialAckRelease}" == true ]]; then
        emitRawPacket "2020-01-01T00:00:00.003000Z" \
            "$(buildRawTcpPacket O 500 "$((100 + overlappedLength))" '')"
    fi

    TZ=UTC text2pcap -q -F pcap -t ISO \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${gapTail}" == true ]]; then
    # Exercise repeated ACK-confirmed holes followed by several complete TPKTs
    # at a partial-capture tail. The captured malformed candidates force the
    # same synchronized-parser path as the local residual without embedding
    # any operational capture bytes.
    # A structurally plausible TPKT header advertises a maximum-sized record,
    # but the next ACK-confirmed hole ends that causal delivery epoch before
    # its body arrives. Recovery must resume at the later complete records.
    scanHex="0300ffff02f080"
    missingHex=""
    for ((index = 0; index < 256; index++)); do
        scanHex+="00"
        missingHex+="00"
    done

    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "$(stackDirectMms "${mmsHex}")"
    emitDirectionalPacket I "2020-01-01T00:00:00.001000Z" "${missingHex}"
    emitDirectionalPacket I "2020-01-01T00:00:00.002000Z" "${scanHex}"
    emitDirectionalPacket O "2020-01-01T00:00:00.003000Z" \
        "$(stackDirectMms 'a1050201018300')"
    emitDirectionalPacket I "2020-01-01T00:00:00.004000Z" "${missingHex}"
    emitDirectionalPacket I "2020-01-01T00:00:00.005000Z" "${scanHex}"
    emitDirectionalPacket O "2020-01-01T00:00:00.006000Z" \
        "$(stackDirectMms 'a1050201028300')"
    emitDirectionalPacket I "2020-01-01T00:00:00.007000Z" "${missingHex}"
    emitDirectionalPacket I "2020-01-01T00:00:00.008000Z" \
        "$(stackDirectMms 'a311a00fa1058003766172a006800103850101')$(stackDirectMms 'a311a00fa1058003766172a006800103850102')$(stackDirectMms 'a311a00fa1058003766172a006800103850103')"
    emitDirectionalPacket O "2020-01-01T00:00:00.009000Z" \
        "$(stackDirectMms 'a1050201038300')"

    temporaryFullPcap="$(mktemp)"
    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${temporaryFullPcap}"
    editcap -F pcap -r "${temporaryFullPcap}" "${outputPcap}" \
        1 3 4 6 7 9 10
    exit 0
fi

if [[ "${gapRecovery}" == true ]]; then
    # Build three consecutive client segments, then remove the middle segment.
    # The retained third segment therefore carries a TCP sequence jump that
    # Zeek reports to the Spicy stream as a capture gap.
    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "$(stackDirectMms "${mmsHex}")"
    emitDirectionalPacket I "2020-01-01T00:00:00.001000Z" \
        "0000000000000000000000000000000000"
    emitDirectionalPacket I "2020-01-01T00:00:00.002000Z" \
        "$(stackDirectMms 'a1050201018300')"
    # The response acknowledges the sequence range beyond the removed segment,
    # allowing Zeek to declare the originator-side hole during offline replay.
    emitDirectionalPacket O "2020-01-01T00:00:00.003000Z" \
        "$(stackDirectMms 'a005020102a300')"
    emitDirectionalPacket I "2020-01-01T00:00:00.004000Z" \
        "$(stackDirectMms 'a005020103a300')"

    temporaryFullPcap="$(mktemp)"
    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${temporaryFullPcap}"
    editcap -F pcap -r "${temporaryFullPcap}" "${outputPcap}" 1 3 4 5
    exit 0
fi

if [[ "${midstreamReverse}" == true ]]; then
    # The first captured application record is responder-to-originator and no
    # Presentation negotiation was captured. Recovery must be direction-
    # independent and retain inferred provenance.
    emitDirectionalPacket O "2020-01-01T00:00:00.000000Z" \
        "$(stackDirectMms "${mmsHex}")"
    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${midstreamMalformed}" == true ]]; then
    # The first PDV has a plausible confirmed-request tag but an impossible
    # service length. A later complete TPKT must recover without publishing a
    # semantic MMS record for the malformed candidate.
    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "$(stackDirectMms 'a005020101a3ff')"
    emitDirectionalPacket I "2020-01-01T00:00:00.001000Z" \
        "$(stackDirectMms "${mmsHex}")"
    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${midstreamAcse}" == true ]]; then
    # A complete AARQ-shaped payload in an otherwise recoverable fully encoded
    # PDV is not an MMS candidate and must remain visible but undispatched.
    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "$(stackDirectPayload 03 '6009a10706052b06010401')"
    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${unknownContext}" == true ]]; then
    # Captured state defines ACSE/BER on context 1. An MMS-shaped transfer on
    # unknown context 3 must not use the no-context-table recovery exception.
    cpAcsePresentation="311aa003800101a213a411300f020101060452010001300406025101"
    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "$(stackPresentation 0d "${cpAcsePresentation}")"
    emitDirectionalPacket I "2020-01-01T00:00:00.001000Z" \
        "$(stackDirectMms "${mmsHex}")"
    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${captureBoundary}" == true ]]; then
    # Begin inside an unavailable prior record, recover at the next complete
    # TPKT, then end inside a following advertised record. Only the complete
    # middle record may produce MMS semantics.
    leadingSuffix="deadbeef"
    truncatedTail="0300001402f0800100610b3009"
    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "${leadingSuffix}$(stackDirectMms "${mmsHex}")$(stackDirectMms 'a311a00fa1058003766172a006800103850101')${truncatedTail}"
    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${bilateralDomainOwnership}" == true ]]; then
    # One negotiated association may carry confirmed requests in both
    # directions.  The same Domain spelling is deliberately learned once per
    # serving endpoint so association-wide union state cannot authorize the
    # opposite server prematurely.
    emitCotpHandshake
    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "$(stackPresentation 0d "${associationCp}")"
    emitDirectionalPacket O "2020-01-01T00:00:00.001000Z" \
        "$(stackPresentation 0e "${associationCpa}")"

    sharedDomainIdentifier="$(tlv 1a "$(asciiHex SHARED)")"
    bilateralTableObject="$(tlv a1 "${sharedDomainIdentifier}$(tlv 1a "$(asciiHex Bilateral_Table_ID)")")"
    probeObject="$(tlv a1 "${sharedDomainIdentifier}$(tlv 1a "$(asciiHex Vendor_Probe)")")"

    bilateralReadVariable="$(tlv 30 "$(tlv a0 "${bilateralTableObject}")")"
    bilateralReadService="$(tlv a4 "$(tlv a1 "$(tlv a0 "${bilateralReadVariable}")")")"
    forwardBilateralRead="$(tlv a0 "020101${bilateralReadService}")"
    forwardBilateralResponse="$(tlv a1 "020101$(tlv a4 "$(tlv a1 "$(tlv 8a "$(asciiHex RESP_VERSION)")")")")"

    # The response is served by the responder, so SHARED becomes bilateral
    # only for object references whose server endpoint is the responder.
    emitDirectionalPacket I "2020-01-01T00:00:00.002000Z" \
        "$(stackDirectMms "${forwardBilateralRead}")"
    emitDirectionalPacket O "2020-01-01T00:00:00.003000Z" \
        "$(stackDirectMms "${forwardBilateralResponse}")"

    reverseProbe="$(tlv a0 "020114$(tlv a6 "$(tlv a0 "${probeObject}")")")"
    forwardProbe="$(tlv a0 "020115$(tlv a6 "$(tlv a0 "${probeObject}")")")"
    emitDirectionalPacket O "2020-01-01T00:00:00.004000Z" \
        "$(stackDirectMms "${reverseProbe}")"
    emitDirectionalPacket I "2020-01-01T00:00:00.005000Z" \
        "$(stackDirectMms "${forwardProbe}")"

    reverseBilateralRead="$(tlv a0 "020102${bilateralReadService}")"
    reverseBilateralResponse="$(tlv a1 "020102$(tlv a4 "$(tlv a1 "$(tlv 8a "$(asciiHex ORIG_VERSION)")")")")"
    emitDirectionalPacket O "2020-01-01T00:00:00.006000Z" \
        "$(stackDirectMms "${reverseBilateralRead}")"
    emitDirectionalPacket I "2020-01-01T00:00:00.007000Z" \
        "$(stackDirectMms "${reverseBilateralResponse}")"

    reverseLearnedProbe="$(tlv a0 "020116$(tlv a6 "$(tlv a0 "${probeObject}")")")"
    forwardStillLearnedProbe="$(tlv a0 "020117$(tlv a6 "$(tlv a0 "${probeObject}")")")"
    emitDirectionalPacket O "2020-01-01T00:00:00.008000Z" \
        "$(stackDirectMms "${reverseLearnedProbe}")"
    emitDirectionalPacket I "2020-01-01T00:00:00.009000Z" \
        "$(stackDirectMms "${forwardStillLearnedProbe}")"

    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${typeDiscovery}" == true ||
      "${extendedClassification}" == true ||
      "${supplementalClassification}" == true ||
      "${controlClassification}" == true ||
      "${selectClassification}" == true ||
      "${tagClassification}" == true ||
      "${dsTransferParameters}" == true ||
      "${dataSetValidation}" == true ||
      "${aggregateIdentity}" == true ||
      "${deviceAction}" == true ||
      "${informationMessage}" == true ]]; then
    # Negotiate distinct ACSE and MMS Presentation contexts, establish the
        # ACSE association with an embedded MMS Initiate, and only then observe
        # standardized-object evidence. Exact named types come from explicit
        # bilateral/site configuration, never from the inline TypeDescription.
    emitCotpHandshake
    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "$(stackPresentation 0d "${associationCp}")"
    emitDirectionalPacket O "2020-01-01T00:00:00.001000Z" \
        "$(stackPresentation 0e "${associationCpa}")"
    emitDirectionalPacket I "2020-01-01T00:00:00.003000Z" \
        "$(stackDirectMms "${mmsHex}")"
    # A completed, direction-correct Read of a mandatory standardized object
    # supplies affirmative TASE.2 evidence. A GVA request by itself is only a
    # peer claim and must never bootstrap protocol classification.
    bootstrapReadResponse="$(tlv a1 "020109$(tlv a4 "$(tlv a1 '840204a0')")")"
    emitDirectionalPacket O "2020-01-01T00:00:00.003500Z" \
        "$(stackDirectMms "${bootstrapReadResponse}")"
    if [[ "${aggregateIdentity}" == true ]]; then
        # GetNameList results are identifiers in the requested object class,
        # not ObjectNames with the response's neutral aggregate scope.
        nameListRequest="a00e020114a109a003800100a1028000"
        returnedIdentifier="$(tlv 1a "$(asciiHex Vendor_Returned)")"
        nameListResponse="$(tlv a1 "020114$(tlv a1 "$(tlv a0 "${returnedIdentifier}")810100")")"
        emitDirectionalPacket I "2020-01-01T00:00:00.004000Z" \
            "$(stackDirectMms "${nameListRequest}")"
        emitDirectionalPacket O "2020-01-01T00:00:00.005000Z" \
            "$(stackDirectMms "${nameListResponse}")"

        # Exercise both permitted scopes plus every suffix boundary that
        # separates a canonical fixed Info_Buff_N name from a private name.
        vmdInfoObject="$(tlv 80 "$(asciiHex Info_Buff_8)")"
        maxInfoObject="$(tlv a1 "$(tlv 1a "$(asciiHex D)")$(tlv 1a "$(asciiHex Info_Buff_16777216)")")"
        leadingZeroObject="$(tlv 80 "$(asciiHex Info_Buff_08)")"
        zeroObject="$(tlv 80 "$(asciiHex Info_Buff_0)")"
        overCapObject="$(tlv 80 "$(asciiHex Info_Buff_16777217)")"
        aaInfoObject="$(tlv 82 "$(asciiHex Info_Buff_8)")"
        emitDirectionalPacket I "2020-01-01T00:00:00.006000Z" \
            "$(stackDirectMms "$(tlv a0 "020115$(tlv a6 "$(tlv a0 "${vmdInfoObject}")")")")"
        emitDirectionalPacket I "2020-01-01T00:00:00.007000Z" \
            "$(stackDirectMms "$(tlv a0 "020116$(tlv a6 "$(tlv a0 "${maxInfoObject}")")")")"
        emitDirectionalPacket I "2020-01-01T00:00:00.008000Z" \
            "$(stackDirectMms "$(tlv a0 "020117$(tlv a6 "$(tlv a0 "${leadingZeroObject}")")")")"
        emitDirectionalPacket I "2020-01-01T00:00:00.009000Z" \
            "$(stackDirectMms "$(tlv a0 "020118$(tlv a6 "$(tlv a0 "${zeroObject}")")")")"
        emitDirectionalPacket I "2020-01-01T00:00:00.010000Z" \
            "$(stackDirectMms "$(tlv a0 "020119$(tlv a6 "$(tlv a0 "${overCapObject}")")")")"
        emitDirectionalPacket I "2020-01-01T00:00:00.011000Z" \
            "$(stackDirectMms "$(tlv a0 "02011a$(tlv a6 "$(tlv a0 "${aaInfoObject}")")")")"

        # The named-list selector remains in ordered Write evidence but must
        # not be copied into the aggregate Named Variable object fields.
        writeSelector="$(tlv a1 "$(tlv 80 "$(asciiHex Vendor_List)")")"
        namedWrite="$(tlv a0 "02011e$(tlv a5 "${writeSelector}$(tlv a0 '850101')")")"
        emitDirectionalPacket I "2020-01-01T00:00:00.012000Z" \
            "$(stackDirectMms "${namedWrite}")"
    elif [[ "${dataSetValidation}" == true ]]; then
        dataSetDomain="D"
        dataSetDomainIdentifier="$(tlv 1a "$(asciiHex "${dataSetDomain}")")"
        goodListObject="$(tlv a1 "${dataSetDomainIdentifier}$(tlv 1a "$(asciiHex GOOD)")")"
        aaListObject="$(tlv a1 "${dataSetDomainIdentifier}$(tlv 1a "$(asciiHex AA_BAD)")")"
        specialListObject="$(tlv a1 "${dataSetDomainIdentifier}$(tlv 1a "$(asciiHex SPECIAL_BAD)")")"
        alternateListObject="$(tlv a1 "${dataSetDomainIdentifier}$(tlv 1a "$(asciiHex ALT_BAD)")")"

        goodMember="$(tlv 30 "$(tlv a0 "$(tlv 80 "$(asciiHex P1)")")")"
        duplicateMember="$(tlv 30 "$(tlv a0 "$(tlv 80 "$(asciiHex P9)")")")"
        aaMember="$(tlv 30 "$(tlv a0 "$(tlv 82 "$(asciiHex P2)")")")"
        specialMember="$(tlv 30 "$(tlv a0 "$(tlv 80 "$(asciiHex Transfer_Set_Name)")")")"
        alternateSelection="$(tlv a5 "$(tlv 81 "$(asciiHex X)")")"
        alternateMember="$(tlv 30 "$(tlv a0 "$(tlv 80 "$(asciiHex P3)")")${alternateSelection}")"

        goodDefine="$(tlv a0 "02010a$(tlv ab "${goodListObject}$(tlv a0 "${goodMember}")")")"
        # This request is intentionally outstanding before GOOD is learned;
        # response-time duplicate detection must still preserve P1.
        duplicateDefine="$(tlv a0 "02010e$(tlv ab "${goodListObject}$(tlv a0 "${duplicateMember}")")")"
        aaDefine="$(tlv a0 "02010b$(tlv ab "${aaListObject}$(tlv a0 "${aaMember}")")")"
        specialDefine="$(tlv a0 "02010c$(tlv ab "${specialListObject}$(tlv a0 "${specialMember}")")")"
        alternateDefine="$(tlv a0 "02010d$(tlv ab "${alternateListObject}$(tlv a0 "${alternateMember}")")")"

        emitDirectionalPacket I "2020-01-01T00:00:00.004000Z" \
            "$(stackDirectMms "${goodDefine}")"
        emitDirectionalPacket I "2020-01-01T00:00:00.005000Z" \
            "$(stackDirectMms "${duplicateDefine}")"
        emitDirectionalPacket I "2020-01-01T00:00:00.006000Z" \
            "$(stackDirectMms "${aaDefine}")"
        emitDirectionalPacket O "2020-01-01T00:00:00.007000Z" \
            "$(stackDirectMms 'a10502010b8b00')"
        emitDirectionalPacket I "2020-01-01T00:00:00.008000Z" \
            "$(stackDirectMms "${specialDefine}")"
        emitDirectionalPacket O "2020-01-01T00:00:00.009000Z" \
            "$(stackDirectMms 'a10502010c8b00')"
        emitDirectionalPacket I "2020-01-01T00:00:00.010000Z" \
            "$(stackDirectMms "${alternateDefine}")"
        emitDirectionalPacket O "2020-01-01T00:00:00.011000Z" \
            "$(stackDirectMms 'a10502010d8b00')"
        emitDirectionalPacket O "2020-01-01T00:00:00.012000Z" \
            "$(stackDirectMms 'a10502010a8b00')"
        emitDirectionalPacket O "2020-01-01T00:00:00.013000Z" \
            "$(stackDirectMms 'a10502010e8b00')"
        goodReport="$(tlv a3 "$(tlv a0 "$(tlv a1 "${goodListObject}")$(tlv a0 '850101')")")"
        emitDirectionalPacket O "2020-01-01T00:00:00.014000Z" \
            "$(stackDirectMms "${goodReport}")"
    elif [[ "${dsTransferParameters}" == true ]]; then
        transferObjectName="$(tlv a1 '1a10434f4e54524f4c5f43454e5445525f421a0854535f5459504544')"
        transferAttributes="$(tlv a6 "$(tlv a0 "${transferObjectName}")")"
        transferAttributesRequest="$(tlv a0 "020101${transferAttributes}")"

        # A GetVariableAccessAttributes response carries the inline
        # TypeDescription, not the named type's name.  Describe the complete
        # 13-member DSTransferSet shape (component names are optional in MMS)
        # instead of the former contradictory Integer16 description.
        objectNameTypeComponents="$(tlv 30 "$(tlv a1 '860108')")"
        objectNameTypeComponents+="$(tlv 30 "$(tlv a1 '8a01e0')")"
        objectNameTypeComponents+="$(tlv 30 "$(tlv a1 '8a01e0')")"
        objectNameType="$(tlv a2 "$(tlv a1 "${objectNameTypeComponents}")")"
        dstTypeComponents="$(tlv 30 "$(tlv a1 "${objectNameType}")")"
        integer32TypeComponent="$(tlv 30 "$(tlv a1 '850120')")"
        dstTypeComponents+="${integer32TypeComponent}${integer32TypeComponent}${integer32TypeComponent}${integer32TypeComponent}${integer32TypeComponent}"
        dstTypeComponents+="$(tlv 30 "$(tlv a1 '840105')")"
        booleanTypeComponent="$(tlv 30 "$(tlv a1 '8300')")"
        dstTypeComponents+="${booleanTypeComponent}${booleanTypeComponent}${booleanTypeComponent}${booleanTypeComponent}${booleanTypeComponent}"
        dstTypeComponents+="$(tlv 30 "$(tlv a1 '850110')")"
        dstType="$(tlv a2 "$(tlv a1 "${dstTypeComponents}")")"
        transferAttributesResponse="$(tlv a1 "020101$(tlv a6 "800100$(tlv a2 "${dstType}")")")"
        emitDirectionalPacket I "2020-01-01T00:00:00.004000Z" \
            "$(stackDirectMms "${transferAttributesRequest}")"
        emitDirectionalPacket O "2020-01-01T00:00:00.005000Z" \
            "$(stackDirectMms "${transferAttributesResponse}")"

        # Confirm the referenced Domain-specific Data Set so the later report
        # has independent member state as well as the DSTransferSet reference.
        dataSetObjectName="$(tlv a1 '1a10434f4e54524f4c5f43454e5445525f421a08444154415f534554')"
        dataSetMembers="a0103006a004800250313006a00480025032"
        dataSetDefineRequest="$(tlv a0 "020104$(tlv ab "${dataSetObjectName}${dataSetMembers}")")"
        emitDirectionalPacket I "2020-01-01T00:00:00.006000Z" \
            "$(stackDirectMms "${dataSetDefineRequest}")"
        emitDirectionalPacket O "2020-01-01T00:00:00.007000Z" \
            "$(stackDirectMms 'a1050201048b00')"

        dataSetName="$(tlv a2 '8601018a10434f4e54524f4c5f43454e5445525f428a08444154415f534554')"
        transferComponents="${dataSetName}85046553f10085013c85010585010285020e10840203a88301008301ff8301ff8301008301ff850107"
        transferValue="$(tlv a2 "${transferComponents}")"
        transferVariable="$(tlv 30 "$(tlv a0 "${transferObjectName}")")"
        transferWrite="$(tlv a5 "$(tlv a0 "${transferVariable}")$(tlv a0 "${transferValue}")")"
        transferRequest="$(tlv a0 "020102${transferWrite}")"
        emitDirectionalPacket I "2020-01-01T00:00:00.008000Z" \
            "$(stackDirectMms "${transferRequest}")"
        emitDirectionalPacket O "2020-01-01T00:00:00.009000Z" \
            "$(stackDirectMms 'a107020102a5028100')"

        # BER permits every nonzero one-octet Boolean TRUE value. Repeat the
        # exact Write with 0x01 TRUE octets; it remains standards-conformant.
        alternateTrueComponents="${dataSetName}85046553f10085013c85010585010285020e10840203a8830100830101830101830100830101850107"
        alternateTrueValue="$(tlv a2 "${alternateTrueComponents}")"
        alternateTrueWrite="$(tlv a5 "$(tlv a0 "${transferVariable}")$(tlv a0 "${alternateTrueValue}")")"
        alternateTrueRequest="$(tlv a0 "020103${alternateTrueWrite}")"
        emitDirectionalPacket I "2020-01-01T00:00:00.010000Z" \
            "$(stackDirectMms "${alternateTrueRequest}")"
        emitDirectionalPacket O "2020-01-01T00:00:00.011000Z" \
            "$(stackDirectMms 'a107020103a5028100')"
        dataSetReport="$(tlv a3 "$(tlv a0 "$(tlv a1 "${dataSetObjectName}")$(tlv a0 '850101850102')")")"
        emitDirectionalPacket O "2020-01-01T00:00:00.012000Z" \
            "$(stackDirectMms "${dataSetReport}")"
    elif [[ "${controlClassification}" == true ]]; then
        emitDirectionalPacket I "2020-01-01T00:00:00.004000Z" \
            "$(stackDirectMms 'a010020101a60ba0098007425245414b4552')"
        emitDirectionalPacket O "2020-01-01T00:00:00.005000Z" \
            "$(stackDirectMms 'a10d020101a608800100a203850110')"
        emitDirectionalPacket I "2020-01-01T00:00:00.006000Z" \
            "$(stackDirectMms 'a019020102a514a00d300ba0098007425245414b4552a003850101')"
        emitDirectionalPacket O "2020-01-01T00:00:00.007000Z" \
            "$(stackDirectMms 'a107020102a5028100')"
    elif [[ "${selectClassification}" == true ]]; then
        emitDirectionalPacket I "2020-01-01T00:00:00.004000Z" \
            "$(stackDirectMms 'a014020101a60fa00d800b425245414b45525f53424f')"
        emitDirectionalPacket O "2020-01-01T00:00:00.005000Z" \
            "$(stackDirectMms 'a10d020101a608800100a203850110')"
        emitDirectionalPacket I "2020-01-01T00:00:00.006000Z" \
            "$(stackDirectMms 'a01a020102a415a113a011300fa00d800b425245414b45525f53424f')"
        emitDirectionalPacket O "2020-01-01T00:00:00.007000Z" \
            "$(stackDirectMms 'a10a020102a405a10385012a')"
    elif [[ "${tagClassification}" == true ]]; then
        emitDirectionalPacket I "2020-01-01T00:00:00.004000Z" \
            "$(stackDirectMms 'a014020101a60fa00d800b425245414b45525f544147')"
        tagTypeComponents="$(typeComponent '840103')"
        tagTypeComponents+="$(typeComponent '8a02ff01')"
        tagType="$(structureType "${tagTypeComponents}")"
        emitDirectionalPacket O "2020-01-01T00:00:00.005000Z" \
            "$(stackDirectMms "$(gvaTypeResponse "${tagType}")")"
        emitDirectionalPacket I "2020-01-01T00:00:00.006000Z" \
            "$(stackDirectMms 'a027020102a522a011300fa00d800b425245414b45525f544147a00da20b840205608a056d61696e74')"
        emitDirectionalPacket O "2020-01-01T00:00:00.007000Z" \
            "$(stackDirectMms 'a107020102a5028100')"
        emitDirectionalPacket I "2020-01-01T00:00:00.008000Z" \
            "$(stackDirectMms 'a01a020103a415a113a011300fa00d800b425245414b45525f544147')"
        emitDirectionalPacket O "2020-01-01T00:00:00.009000Z" \
            "$(stackDirectMms 'a114020103a40fa10da20b840205608a056d61696e74')"
    elif [[ "${deviceAction}" == true ]]; then
        emitDirectionalPacket O "2020-01-01T00:00:00.004000Z" \
            "$(stackDirectMms 'a32ba229a0098007454e524f4c4c31a111800f425245414b45525f73756363657373820100830102a40381012a')"
    elif [[ "${informationMessage}" == true ]]; then
        emitDirectionalPacket I "2020-01-01T00:00:00.004000Z" \
            "$(stackDirectMms 'a03b020101ab36a10b1a01441a064d53475f5453a0273014a0128010496e666f5f4d6573735f486561646572300fa00d800b496e666f5f427566665f38')"
        emitDirectionalPacket O "2020-01-01T00:00:00.005000Z" \
            "$(stackDirectMms 'a1050201018b00')"
        emitDirectionalPacket O "2020-01-01T00:00:00.006000Z" \
            "$(stackDirectMms 'a32ba029a10da10b1a01441a064d53475f5453a018a20c850101850102850103850105890868656c6c6f000000')"
    else
        emitDirectionalPacket I "2020-01-01T00:00:00.004000Z" \
            "$(stackDirectMms 'a00f020101a60aa0088006506f696e7431')"
        pointTypeComponents=""
        if [[ "${supplementalClassification}" == true ]]; then
            extendedTimestampComponents="$(typeComponent '850120')"
            extendedTimestampComponents+="$(typeComponent '850110')"
            extendedTimestampType="$(structureType "${extendedTimestampComponents}")"
            pointTypeComponents="$(typeComponent '840108')"
            pointTypeComponents+="$(typeComponent "${extendedTimestampType}")"
            pointTypeComponents+="$(typeComponent '840108')"
        elif [[ "${extendedClassification}" == true ]]; then
            extendedTimestampComponents="$(typeComponent '850120')"
            extendedTimestampComponents+="$(typeComponent '850110')"
            extendedTimestampType="$(structureType "${extendedTimestampComponents}")"
            pointTypeComponents="$(typeComponent 'a706020120020108')"
            pointTypeComponents+="$(typeComponent "${extendedTimestampType}")"
            pointTypeComponents+="$(typeComponent '840108')"
        else
            pointTypeComponents="$(typeComponent 'a706020120020108')"
            pointTypeComponents+="$(typeComponent '840108')"
        fi
        pointType="$(structureType "${pointTypeComponents}")"
        emitDirectionalPacket O "2020-01-01T00:00:00.005000Z" \
            "$(stackDirectMms "$(gvaTypeResponse "${pointType}")")"
        if [[ "${readClassification}" == true ]]; then
            emitDirectionalPacket I "2020-01-01T00:00:00.006000Z" \
                "$(stackDirectMms 'a015020102a410a10ea00c300aa0088006506f696e7431')"
            if [[ "${supplementalClassification}" == true ]]; then
                emitDirectionalPacket O "2020-01-01T00:00:00.007000Z" \
                    "$(stackDirectMms 'a11c020102a417a115a2138402006ca20985046553f10085017b840200aa')"
            elif [[ "${extendedClassification}" == true ]]; then
                emitDirectionalPacket O "2020-01-01T00:00:00.007000Z" \
                    "$(stackDirectMms 'a11f020102a41aa118a21687050841200000a20985046553f10085017b840200aa')"
            else
                emitDirectionalPacket O "2020-01-01T00:00:00.007000Z" \
                    "$(stackDirectMms 'a114020102a40fa10da20b870508412000008402002a')"
            fi
        else
            emitDirectionalPacket O "2020-01-01T00:00:00.007000Z" \
                "$(stackDirectMms 'a31fa01da00c300aa0088006506f696e7431a00da20b870508412000008402002a')"
        fi
    fi

    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${directNegotiated}" == true ||
      "${directRejected}" == true ||
      "${directUnmatched}" == true ]]; then
    cpPresentation="311ba003800101a214a4123010020103060528ca220201300406025101"
    acceptedPresentation="3112a003800101a20ba509300780010081025101"
    rejectedPresentation="310ea003800101a207a5053003800101"

    if [[ "${directUnmatched}" != true ]]; then
        emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
            "$(stackPresentation 0d "${cpPresentation}")"
    fi

    if [[ "${directRejected}" == true ]]; then
        cpaPresentation="${rejectedPresentation}"
    else
        cpaPresentation="${acceptedPresentation}"
    fi

    emitDirectionalPacket O "2020-01-01T00:00:00.001000Z" \
        "$(stackPresentation 0e "${cpaPresentation}")"
    if [[ "${identifyUnmatched}" != true ]]; then
        emitDirectionalPacket I "2020-01-01T00:00:00.002000Z" \
            "$(stackDirectMms "${mmsHex}")"
    fi

    if [[ "${directNegotiated}" == true ]]; then
        if [[ "${identifyExchange}" == true ]]; then
            identifyResponseDirection=O
            if [[ "${identifyDirectionMismatch}" == true ]]; then
                identifyResponseDirection=I
            fi
            emitDirectionalPacket "${identifyResponseDirection}" \
                "2020-01-01T00:00:00.003000Z" \
                "$(stackDirectMms 'a11d020101a218800441636d6581024d318203312e30a307060528ca220201')"
            if [[ "${identifyUnmatched}" != true &&
                  "${identifyDirectionMismatch}" != true ]]; then
                emitDirectionalPacket O "2020-01-01T00:00:00.004000Z" \
                    "$(stackDirectMms 'a311a00fa1058003766172a006800103850101')"
            fi
        else
            emitDirectionalPacket O "2020-01-01T00:00:00.003000Z" \
                "$(stackDirectMms 'a1050201018300')"
            emitDirectionalPacket O "2020-01-01T00:00:00.004000Z" \
                "$(stackDirectMms 'a311a00fa1058003766172a006800103850101')"
        fi
    fi

    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${directMms}" != true ]]; then
    # CP/AARQ and CPA/AARE carry the MMS Initiate request/response in their
    # respective Session CONNECT and ACCEPT SPDUs.
    emitCotpHandshake
    emitDirectionalPacket I "2020-01-01T00:00:00.000000Z" \
        "$(stackPresentation 0d "${associationCp}")"
    emitDirectionalPacket O "2020-01-01T00:00:00.001000Z" \
        "$(stackPresentation 0e "${associationCpa}")"

    if [[ "${fixture}" == "unknown-service" ||
          "${fixture}" == "private-object" ]]; then
        emitDirectionalPacket I "2020-01-01T00:00:00.002000Z" \
            "$(stackDirectMms "${mmsHex}")"
    fi

    if [[ "${fixture}" == "release" ]]; then
        emitDirectionalPacket I "2020-01-01T00:00:00.003000Z" \
            "$(stackPresentation 09 "$(presentationPdv 01 '620380011e')")"
        emitDirectionalPacket O "2020-01-01T00:00:00.004000Z" \
            "$(stackPresentation 08 "$(presentationPdv 01 '6303800100')")"
        emitDirectionalPacket I "2020-01-01T00:00:00.005000Z" \
            "$(stackPresentation 09 "$(presentationPdv 01 '620380011e')")"
        emitDirectionalPacket O "2020-01-01T00:00:00.006000Z" \
            "$(stackPresentation 0a "$(presentationPdv 01 '6303800100')")"
    elif [[ "${fixture}" == "abort" ]]; then
        abortContextList="$(tlv a0 "$(tlv 30 '02010106025101')")"
        abortPpdu="$(tlv a0 "${abortContextList}$(presentationPdv 01 '6406800101810102')")"
        emitDirectionalPacket I "2020-01-01T00:00:00.003000Z" \
            "$(stackPresentation 19 "${abortPpdu}")"
    fi

    TZ=UTC text2pcap -q -D -F pcap -t ISO -T 49152,102 \
        "${temporaryHexdump}" "${outputPcap}"
    exit 0
fi

if [[ "${directMms}" == true ]]; then
    pdv="$(tlv 30 "020103$(tlv a0 "${mmsHex}")")"
    presentation="$(tlv 61 "${pdv}")"
    transportPayload="02f0800100${presentation}"
    tpktLength="$(printf '%04x' "$((${#transportPayload} / 2 + 4))")"
    payloadHex=""
    payloadHex+="0300${tpktLength}${transportPayload}"

    if [[ "${truncatedTail}" == true ]]; then
        payloadHex+="0300001402f0800100610b3009"
    fi

    if [[ "${invalidTruncatedTail}" == true ]]; then
        payloadHex+="0300001400"
    fi

    if [[ "${fixture}" == "direct-mms-result-mismatch" ]]; then
        # Follow the rejected two-variable/three-result report with a complete
        # non-result PDU. This gives the stream parser a real structural TPKT
        # boundary to recover at; an inner BER 0x03 must never count as one.
        payloadHex+="$(stackDirectMms 'a0050201018200')"
    fi
fi

printf '%s' "${payloadHex}" | xxd -r -p | xxd -g 1 |
    sed '1s/^/2020-01-01T00:00:00.000000Z /' > "${temporaryHexdump}"
TZ=UTC text2pcap -q -F pcap -t ISO -T 49152,102 \
    "${temporaryHexdump}" "${outputPcap}"
