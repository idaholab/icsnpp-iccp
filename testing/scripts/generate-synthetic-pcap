#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
output_pcap="${1:?usage: generate-synthetic-pcap OUTPUT [SCENARIO]}"
scenario="${2:-default}"
fixture="${script_dir}/../traces/synthetic/${scenario}.pcap"

if [[ ! -f "${fixture}" ]]; then
    echo "unknown synthetic capture scenario: ${scenario}" >&2
    exit 2
fi

cp -- "${fixture}" "${output_pcap}"
