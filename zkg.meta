[package]
script_dir = scripts
plugin_dir = build/spicy-modules
test_command = cd testing && btest -d -c btest.cfg
summary = ICSNPP ICCP/TASE.2 analyzer
description = A Spicy-based Zeek plugin for parsing and logging ICCP/TASE.2 traffic carried by MMS.
tags = ICCP, TASE.2, MMS, ics, ICS, ICSNPP, zeek, spicy
depends =
    zeek >=8.0.0,<10.0.0
build_command = mkdir -p build && cd build && SPICYZ=$(command -v spicyz || echo %(package_base)s/spicy-plugin/build/bin/spicyz) cmake .. && cmake --build . --parallel 2

[template]
source = https://github.com/zeek/package-template
version = v3.1.0
features = spicy-protocol-analyzer

[template_vars]
name = spicy-iccp
analyzer = ICCP
transport = TCP
unit_orig = ICCP_Connection
unit_resp = ICCP_Connection
