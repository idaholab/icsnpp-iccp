################################################################################
##
## ICSNPP - ICCP
##
## This file integrates the ICCP parser with Zeek protocol confirmation and
## error handling.
##
## Christopher B. Peterson and Christian J Weelborg
## Idaho National Lab, November 2026
##
################################################################################

module Zeek_ICCP;

import spicy;
import zeek;
import ICCP;
import ICCP_MMS;

# RFC 1006/COTP/Session are shared by protocols other than ICCP. Confirm only
# after a complete MMS PDU has passed both structural and service-level
# semantic validation, including the direct-transfer recovery path. This still
# confirms long-lived streams before the enclosing TCP direction reaches %done
# without labeling an arbitrary context-specific BER value as ICCP.
on ICCP_MMS::ProvenancedMMSpdu::%done {
    if (
        ICCP_MMS::protocolConfirmationIsValid(
            self.pdu.recognized,
            self.pdu.semanticDecoded
        )
    )
        zeek::confirm_protocol();
}

on ICCP::ICCP_Connection::%done {
    spicy::accept_input();
}

on ICCP::ICCP_Connection::%error(msg: string) {
    spicy::decline_input("error parsing ICCP/TASE.2 stream: %s" % msg);
}
