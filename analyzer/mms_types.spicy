module ICCP_MMS_TYPES;

import spicy;

public type TopLevelPDU = enum {
    CONFIRMED_REQUEST = 0,
    CONFIRMED_RESPONSE = 1,
    CONFIRMED_ERROR = 2,
    UNCONFIRMED = 3,
    REJECT = 4,
    CANCEL_REQUEST = 5,
    CANCEL_RESPONSE = 6,
    CANCEL_ERROR = 7,
    INITIATE_REQUEST = 8,
    INITIATE_RESPONSE = 9,
    INITIATE_ERROR = 10,
    CONCLUDE_REQUEST = 11,
    CONCLUDE_RESPONSE = 12,
    CONCLUDE_ERROR = 13,
    UNKNOWN = 255
};
